{
    "name": "epass-web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "set NODE_OPTIONS=--max-old-space-size=8192 && wagmi generate && next dev",
        "build": "set NODE_OPTIONS=--max-old-space-size=8192 && wagmi generate && next build",
        "start": "set NODE_OPTIONS=--max-old-space-size=8192 && wagmi generate && next start",
        "wagmi": "wagmi generate",
        "wagmi:watch": "wagmi generate --watch",
        "db:reset": "tsx scripts/db-reset.ts",
        "db:seed": "tsx scripts/db-seed.ts",
        "test:e2e": "pnpm exec bddgen && pnpm exec playwright test",
        "test:e2e:ui": "pnpm exec bddgen && pnpm exec playwright test --ui",
        "test:e2e:report": "pnpm exec playwright show-report",
        "test:e2e:install:linux": "pnpm exec playwright install-deps",
        "test:e2e:install:arch": "sudo pacman -S --needed nspr nss alsa-lib at-spi2-core cups libdrm libxcomposite libxdamage libxrandr mesa pango cairo libxkbcommon",
        "bdd:gen": "pnpm exec bddgen",
        "// biome:format": "Formats all files and writes changes",
        "biome:format": "biome format --write .",
        "// biome:lint": "Lints code and applies safe autofixes",
        "biome:lint": "biome lint --write .",
        "// biome:check": "Combines formatting, linting, and import sorting",
        "biome:check": "biome check --write .",
        "// biome:reset": "Purges Biome's cache and forces a fresh, hard check across the repo",
        "biome:reset": "biome clean && biome check --write --no-errors-on-unmatched ."
    },
    "dependencies": {
        "@ai-sdk/groq": "^3.0.39",
        "@ai-sdk/react": "^3.0.197",
        "@metamask/connect-evm": "^1.4.0",
        "@paper-design/shaders-react": "^0.0.76",
        "@rainbow-me/rainbowkit": "^2.2.11",
        "@tanstack/react-form": "^1.32.0",
        "@tanstack/react-query": "^5.100.14",
        "ai": "^6.0.195",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.40.0",
        "iron-session": "^8.0.4",
        "lucide-react": "^1.16.0",
        "mongoose": "^9.6.2",
        "motion": "^12.40.0",
        "next": "16.2.6",
        "next-auth": "^4.24.14",
        "next-env-safe": "^1.0.2",
        "next-themes": "^0.4.6",
        "pinata-web3": "^0.5.4",
        "radix-ui": "^1.4.3",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "recharts": "^3.8.1",
        "shadcn": "^4.8.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "viem": "^2.51.0",
        "wagmi": "^3.6.16",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@wagmi/cli": "^2.10.0",
        "playwright-bdd": "^9.0.0",
        "postcss": "^8.5.15",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
